{
  "name": "silverline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,worker 'pnpm dev:web' 'pnpm worker'",
    "dev:web": "vp dev --host 127.0.0.1 --port 3000",
    "worker": "varlock run -- tsx src/worker/main.ts",
    "build": "vp build",
    "start": "varlock run -- node scripts/serve.mjs",
    "check": "vp check && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "eval": "varlock run -- tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@effect/ai-openrouter": "4.0.0-rc.116",
    "@effect/platform-node": "4.0.0-rc.116",
    "@effect/sql-sqlite-node": "4.0.0-rc.116",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "@tanstack/react-table": "8.21.3",
    "@varlock/vite-integration": "1.5.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-rc.116",
    "fflate": "0.8.3",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "varlock": "1.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.5.1"
}
